# ═══════════════════════════════════════════════════════════════
#  NEXAURA — Backend Environment Variables
#  Copy this file to .env and fill in real values.
# ═══════════════════════════════════════════════════════════════

# ── Database (PostgreSQL / Neon) ──────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@<EP_HOST>.neon.tech/upsteky?sslmode=require

# ── Google Gemini AI ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Clerk Authentication & Webhooks ──────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_ISSUER=https://emerging-feline-53.clerk.accounts.dev
CLERK_JWKS_URL=https://emerging-feline-53.clerk.accounts.dev/.well-known/jwks.json

# ── Admin Portal ──────────────────────────────────────────────────
# REQUIRED: Set a strong password before deploying. Admin login is
# disabled if ADMIN_PASSWORD is not set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_JWT_SECRET=your_random_jwt_secret_here

# ── Cache (Valkey / Redis) ────────────────────────────────────────
# Optional. Caching is gracefully disabled if this is not set.
# Defaults to redis://localhost:6379/0
VALKEY_URL=redis://localhost:6379/0

# ── CORS Origins ──────────────────────────────────────────────────
# Comma-separated list of extra allowed origins.
# (LAN IPs like 192.168.x.x, 10.x.x.x, and localhost are automatically allowed)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ── App Environment ───────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
